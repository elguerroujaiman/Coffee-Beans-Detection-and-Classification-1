# Flask session signing key. Blank means a random development-only key.
FLASK_SECRET_KEY=
APP_ENV=development

# Optional Gemini key for generated real-time session reports.
GEMINI_API_KEY=

# Upload limit in megabytes.
MAX_UPLOAD_MB=100

# Docker video stream port. Change if this port is already in use.
STREAM_PORT=5002

# Single-output model decision threshold.
CLASSIFICATION_THRESHOLD=0.60

# Optional live-detection tuning values (defaults are in detection_worker.py).
MIN_CLASSIFY_BOX_AREA=9000
MIN_BROWN_RATIO=0.20
MIN_TRACK_BOX_AREA=5000
MIN_TRACK_BROWN_RATIO=0.12
MIN_VISIBLE_FRAMES=1
MIN_STABLE_FRAMES=1
FORCE_CLASSIFY_FRAMES=6
STABLE_IOU_THRESHOLD=0.30
MORPH_OPEN_ITERS=3
MORPH_CLOSE_ITERS=1
ALLOW_LATE_SPAWN=1
LATE_SPAWN_MAX_X_RATIO=0.85
DUPLICATE_IOU_THRESHOLD=0.55
NEW_TRACK_SUPPRESS_IOU=0.18
EDGE_ENTRY_MIN_AREA_FACTOR=0.75
DUPLICATE_CENTER_DIST_RATIO=0.30
NEW_TRACK_SUPPRESS_CENTER_DIST_RATIO=0.35
CLASSIFY_CENTER_MIN_X_RATIO=0.16
CLASSIFY_CENTER_MAX_X_RATIO=0.90
